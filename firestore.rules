rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'olucasalveszx@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /likedPros/{proId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // --- Appointments Collection ---
    match /appointments/{appointmentId} {
      allow read, list: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.proId == request.auth.uid
      );
      
      allow create: if isSignedIn() 
                    && incoming().clientId == request.auth.uid
                    && isValidAppointment(incoming());
                    
      allow update: if isSignedIn() && (
        (existing().clientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (existing().proId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );

      function isValidAppointment(data) {
        return data.clientId is string && data.proId is string
            && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
            && data.time is string;
      }
    }

    // --- Professionals Collection ---
    match /professionals/{proId} {
      allow read: if true; 
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(proId) && (
        !incoming().keys().hasAny(['isVerified']) || incoming().isVerified == false || isAdmin()
      );
      allow update: if isSignedIn() && (
        proId == request.auth.uid ||
        existing().userId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      // --- Queue Subcollection ---
      match /queue/{entryId} {
        allow read, list: if true; // Everyone can see wait times/position
        
        allow create: if isSignedIn() 
                      && incoming().clientId == request.auth.uid
                      && isValidQueueEntry(incoming());
                      
        allow update: if isSignedIn() && (
          (existing().clientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          (proId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAny(['status', 'position', 'calledAt']))
        );

        function isValidQueueEntry(data) {
          return data.clientId is string && data.clientName is string
              && data.status in ['waiting', 'called', 'in_service', 'completed', 'cancelled']
              && data.position is number;
        }
      }

      // --- Catalog Subcollection (serviços do profissional) ---
      match /catalog/{itemId} {
        allow read, list: if true;
        allow create, update, delete: if isSignedIn() && (proId == request.auth.uid || isAdmin());
      }

      // --- Portfolio Subcollection ---
      match /portfolio/{itemId} {
        allow read: if true;
        
        allow create, update, delete: if isSignedIn() && (proId == request.auth.uid || isAdmin());

        match /likes/{userId} {
          allow read: if true;
          allow create, delete: if isOwner(userId);
        }

        match /comments/{commentId} {
          allow read: if true;
          allow create: if isSignedIn() && incoming().userId == request.auth.uid;
          allow delete: if isAdmin() || (isSignedIn() && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/professionals/$(proId)).data.userId == request.auth.uid));
        }
      }
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Identity-Based Read: Explicitly check resource.data to prevent blanket scans
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        (resource.data.type == 'smart_budget' && isProfessionalActive(request.auth.uid))
      );

      // Strict Listing: Mandatory filters must be applied by client
      allow list: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        (resource.data.type == 'smart_budget' && isProfessionalActive(request.auth.uid))
      );

      allow create: if isSignedIn() 
                    && incoming().clientId == request.auth.uid
                    && isValidOrder(incoming());
                    
      allow update: if isSignedIn() && (
        (existing().clientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'updatedAt', 'rating'])) ||
        (existing().professionalId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'rating'])) ||
        isAdmin()
      );

      // Allow deleting orders if user is involved (client or professional)
      allow delete: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.professionalId == request.auth.uid ||
        isAdmin()
      );

      function isValidOrder(data) {
        return data.clientId is string
            && (data.status in ['pending', 'confirmed', 'scheduled', 'in_progress', 'completed', 'cancelled'])
            && (
              (data.keys().hasAny(['serviceTitle']) && data.serviceTitle is string) ||
              (data.keys().hasAny(['title']) && data.title is string)
            );
      }
    }

    // --- Chats Collection ---
    match /chats/{chatId} {
      allow read, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in existing().participants;

      match /messages/{msgId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                      && incoming().senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && incoming().diff(existing()).affectedKeys().hasOnly(['proposal']);
      }
    }

    // --- Notifications Collection ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId != null;
      allow update: if isSignedIn() && existing().userId == request.auth.uid 
                    && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    // --- Emergency Numbers Collection ---
    match /emergency_numbers/{numberId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    function isProfessionalActive(userId) {
      return exists(/databases/$(database)/documents/professionals/$(userId)) &&
             get(/databases/$(database)/documents/professionals/$(userId)).data.subscriptionStatus == 'active' &&
             (get(/databases/$(database)/documents/professionals/$(userId)).data.subscriptionType
               in ['start', 'pro', 'ultra', 'monthly_pro', 'annual_pro']);
    }

    // --- Smart Requests Collection (broadcast budget requests) ---
    match /smartRequests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().clientId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn();
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read, list: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        (incoming().proId == request.auth.uid && isProfessionalActive(request.auth.uid))
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().proId == request.auth.uid && isProfessionalActive(request.auth.uid))
      );
      allow delete: if isSignedIn() && (existing().proId == request.auth.uid || isAdmin());
    }
  }
}
